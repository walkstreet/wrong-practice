# 开发环境默认使用本机 PostgreSQL（先执行 ./scripts/setup-dev-db.sh）
DATABASE_URL=postgresql+psycopg://localhost:5432/wrong_questions
# 若本机角色名不是当前系统用户，写成：postgresql+psycopg://用户名@127.0.0.1:5432/wrong_questions
# 旧的 SQLite 仅作兼容：sqlite:///./wrong_questions.db
# 生产脚本 start-prod.sh 目前仍支持 SQLITE_DATA_DIR=../db，发布时再切 PostgreSQL
API_KEY=dify-dev-key
# HS256 要求至少 32 字节，开发可先用占位，上线务必换成随机串
JWT_SECRET=dev-only-change-me-use-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 文本分析：DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 图片识别：千问等视觉模型（OpenAI 兼容）
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen3.7-flash
